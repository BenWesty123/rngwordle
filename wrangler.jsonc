{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rngwordle",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rngwordle"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@rwgdle.app"]
    }
  ],
  // Workers Logs: errors and requests show under the Worker's Observability tab.
  "observability": { "enabled": true },
  // Usernames allowed to open rwgdle.app/stats, comma-separated.
  "vars": { "STATS_USERNAMES": "Westy" },
  // Per-visitor limits, counted at each Cloudflare location. Rolls: 60 a minute. Login emails: 5 a minute.
  "ratelimits": [
    { "name": "ROLL_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rngwordle",
      "database_id": "413e067e-82bf-4059-b9ea-e796869cf7bc",
      "migrations_dir": "migrations"
    }
  ]
}
